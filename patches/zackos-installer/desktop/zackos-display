#!/usr/bin/python3
"""Start LightDM on the installed disk or the temporary i3 session on live media."""
import os
from pathlib import Path
import pwd
import secrets
import shutil
import subprocess
import sys
import time

BIN = "/nix/var/nix/profiles/default/bin"
MARKER = Path("/boot/grub/zackos-first-user")
STATE = Path("/run/zackos-first-session")
SESSION = "/etc/X11/zackos-session"


def account(name):
    user = pwd.getpwnam(name)
    if user.pw_uid < 1000 or user.pw_uid == 65534:
        raise ValueError("live session requires a regular desktop user")
    return user


def start_client(name):
    user = account(name)
    os.initgroups(user.pw_name, user.pw_gid)
    os.setgid(user.pw_gid)
    os.setuid(user.pw_uid)
    os.chdir(user.pw_dir)
    os.execve(SESSION, [SESSION], {
        "DISPLAY": ":0", "XAUTHORITY": str(STATE / "client.auth"),
        "USER": name, "LOGNAME": name, "HOME": user.pw_dir,
        "SHELL": user.pw_shell, "LANG": "C.UTF-8",
        "PATH": f"{BIN}:/usr/local/bin:/usr/bin:/bin",
    })


def start_display(live=False):
    subprocess.run(["/usr/local/lib/zackos-installer/boot/splash-done"], check=False)
    if not live:
        # X11 session management needs a root-owned sticky ICE socket directory.
        # /tmp can be fresh on every boot. Never follow a symlink in it as root.
        old_umask = os.umask(0)
        try:
            os.mkdir("/tmp/.ICE-unix", 0o1777)
        except FileExistsError:
            pass
        finally:
            os.umask(old_umask)
        # The installed disk has taken over from the ISO, so retire its GRUB handoff.
        MARKER.unlink(missing_ok=True)
        os.environ["PATH"] = f"{BIN}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin"
        for _ in range(100):
            if Path("/run/dbus/system_bus_socket").is_socket():
                break
            time.sleep(.1)
        # Runit starts with a fresh /run. Record graphical sessions in utmp.
        utmp = Path("/run/utmp")
        if not utmp.exists():
            utmp.touch(mode=0o644)
        # Nix PAM looks for its shadow-password helper here. LightDM's PAM child runs as root.
        helper = Path("/run/wrappers/bin/unix_chkpwd")
        helper.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        if not os.path.lexists(helper):
            helper.symlink_to(f"{BIN}/unix_chkpwd")
        manager = "/nix/var/nix/profiles/default/sbin/lightdm"
        os.execv(manager, [manager, "--config=/etc/lightdm/lightdm.conf"])

    if STATE.exists():
        shutil.rmtree(STATE)
    user = account("live")
    STATE.mkdir(mode=0o711)
    STATE.chmod(0o711)
    server = STATE / "server.auth"
    client = STATE / "client.auth"
    server.touch(mode=0o600)
    subprocess.run([f"{BIN}/xauth", "-q", "-f", str(server)],
                   input=f"add :0 . {secrets.token_hex(16)}\n", text=True, check=True)
    client.touch(mode=0o600)
    shutil.copyfile(server, client)
    os.chown(client, user.pw_uid, user.pw_gid)
    os.environ["XAUTHORITY"] = str(server)
    cmd = [f"{BIN}/xinit", os.path.abspath(__file__), "--first-client", user.pw_name,
           "--", f"{BIN}/Xorg", ":0", "vt7", "-nolisten", "tcp", "-auth", str(server)]
    os.execv(cmd[0], cmd)


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--first-client":
        start_client(sys.argv[2])
    else:
        start_display(live=sys.argv[1:] == ["--live"])
